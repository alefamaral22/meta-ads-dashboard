# Meta Ads API — Time de Trafego Pago
# Copie este arquivo para .env e preencha os valores

# Token de acesso Meta (mesmo do instagram-api se tiver permissao ads_read + ads_management)
META_ACCESS_TOKEN=

# ID da conta de anuncios (formato: act_XXXXXXXXXX)
META_AD_ACCOUNT_ID=act_

# ID da pagina do Facebook vinculada (opcional, para criar anuncios)
META_PAGE_ID=

# Versao da API (nao altere sem necessidade)
META_API_VERSION=v19.0
